# Additional settings for the production overlay; merge into a protected deployment env file.
# Retain required database/auth/upload settings from .env.docker.example; never commit actual values.
ASPNETCORE_ENVIRONMENT=Production
IMAGE_TAG=release-tag
PLATFORM_DOMAIN=platform.example.invalid
SCHOOLS_DOMAIN=schools.example.invalid
# Certificate SAN must match this name; the Docker network aliases it to the bundled broker.
RABBITMQ_TLS_HOST=broker.example.invalid
RABBITMQ_AMQPS_URI=
# Absolute directories outside this repository. Files must be readable by their containers.
RABBITMQ_TLS_DIRECTORY=
GATEWAY_TLS_DIRECTORY=
DOCKER_NETWORK_SUBNET=172.30.0.0/24
GATEWAY_INTERNAL_IP=172.30.0.10
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# Defaults are starting points, not a capacity guarantee. Load test against your server.
PLATFORM_API_MEMORY_LIMIT=1g
PLATFORM_WORKER_MEMORY_LIMIT=512m
SCHOOLS_API_MEMORY_LIMIT=2g
PLATFORM_WEB_MEMORY_LIMIT=128m
SCHOOLS_WEB_MEMORY_LIMIT=128m
REDIS_PASSWORD=
SCHOOL_ROUTING_REDIS_CONNECTION=
SCHOOL_ROUTING_CACHE_ENABLED=true
SCHOOL_ROUTING_CACHE_CONSUMER_ENABLED=true
SCHOOL_ROUTING_CACHE_NAMESPACE=mdaresna-production
SCHOOL_ROUTING_CACHE_TTL_SECONDS=2592000

# Document storage: keep Local until the live R2 test and any migration have passed.
SCHOOL_DOCUMENT_STORAGE_PROVIDER=Local
SCHOOL_DOCUMENT_R2_ENDPOINT=
SCHOOL_DOCUMENT_R2_BUCKET=
SCHOOL_DOCUMENT_R2_ACCESS_KEY_ID=
SCHOOL_DOCUMENT_R2_SECRET_ACCESS_KEY=
SCHOOL_DOCUMENT_R2_MAX_UPLOAD_MIB=64
SCHOOL_DOCUMENT_R2_CONCURRENT_UPLOADS=2
