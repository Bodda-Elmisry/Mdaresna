      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Mdaresna.Api.Contracts\Mdaresna.Api.Contracts.csproj" />
    <ProjectReference Include="..\Mdaresna.Platform.Application\Mdaresna.Platform.Application.csproj" />
    <ProjectReference Include="..\Mdaresna.Platform.Infrastructure\Mdaresna.Platform.Infrastructure.csproj" />
  </ItemGroup>

</Project>
