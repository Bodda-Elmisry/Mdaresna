map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# Never log query strings: SignalR may send access_token during websocket negotiation.
log_format safe '$remote_addr $request_method $uri $status $body_bytes_sent';
access_log /var/log/nginx/access.log safe;
error_log /var/log/nginx/error.log crit;
server {
    listen 80 default_server;
    server_name _;
    location = /gateway-health { access_log off; return 200 'healthy\n'; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${PLATFORM_DOMAIN};
    ssl_certificate /run/tls/fullchain.pem;
    ssl_certificate_key /run/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 54m;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location /api/ { include /etc/nginx/proxy-common.conf; proxy_pass http://platform-api:8080; }
    location /hubs/ { include /etc/nginx/proxy-common.conf; proxy_pass http://platform-api:8080; }
    location / { include /etc/nginx/proxy-common.conf; proxy_pass http://platform-web:8080; }
}
server {
    listen 443 ssl;
    server_name ${SCHOOLS_DOMAIN};
    ssl_certificate /run/tls/fullchain.pem;
    ssl_certificate_key /run/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 54m;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location /api/ { include /etc/nginx/proxy-common.conf; proxy_pass http://schools-api:8080; }
    location / { include /etc/nginx/proxy-common.conf; proxy_pass http://schools-web:8080; }
}
