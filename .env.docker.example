# Copy this file to .env.docker. Values marked CHANGE_ME are placeholders, not real secrets.
ASPNETCORE_ENVIRONMENT=Development
CONTAINER_REGISTRY=local
IMAGE_TAG=dev

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432
PLATFORM_DB_CONNECTION=Host=postgres;Port=5432;Database=mdaresna_platform;Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD
IDENTITY_DB_CONNECTION=Host=postgres;Port=5432;Database=mdaresna_identity;Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD
SCHOOL_DB_ADMIN_CONNECTION=Host=postgres;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD
SCHOOL_DB_CREDENTIAL_FRAGMENT=Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD
SCHOOL_DB_NAME_PREFIX=mdaresna_school_

RABBITMQ_USER=mdaresna
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_BROKER_URI=amqp://mdaresna:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

PLATFORM_API_PORT=5241
PLATFORM_WORKER_HEALTH_PORT=5081
SCHOOLS_API_PORT=5251
PLATFORM_WEB_PORT=8082
SCHOOLS_WEB_PORT=8083
PLATFORM_WEB_ORIGIN=http://localhost:8082
SCHOOLS_WEB_ORIGIN=http://localhost:8083
PLATFORM_API_PUBLIC_URL=http://localhost:5241/
SCHOOLS_API_PUBLIC_URL=http://localhost:5251

PLATFORM_JWT_ISSUER=mdaresna-platform
PLATFORM_JWT_AUDIENCE=mdaresna-platform-api
PLATFORM_JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PLATFORM_ACCESS_TOKEN_MINUTES=15
PLATFORM_ACTIVATION_CODE_HASH_KEY=CHANGE_ME_BASE64_ENCODED_32_RANDOM_BYTES
SCHOOLS_JWT_ISSUER=mdaresna-schools
SCHOOLS_JWT_AUDIENCE=mdaresna-schools-api
SCHOOLS_JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
SCHOOLS_ACCESS_TOKEN_MINUTES=15
SCHOOL_DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
# Base64 of 32 random bytes, supplied from secret storage. Do not rotate existing keys blindly.
PLATFORM_UPLOAD_ENCRYPTION_KEY=
SCHOOLS_UPLOAD_ENCRYPTION_KEY=
PLATFORM_UPLOAD_ACTIVE_KEY_ID=primary
SCHOOLS_UPLOAD_ACTIVE_KEY_ID=primary
# Keep true until legacy files have been migrated and audited. New writes are always encrypted.
PLATFORM_UPLOAD_ALLOW_LEGACY_READ=true
SCHOOLS_UPLOAD_ALLOW_LEGACY_READ=true
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_API_KEY

SCHOOL_PROVISIONING_ENABLED=true
SCHOOL_REGISTRATION_CONSUMER_ENABLED=true
PLATFORM_OUTBOX_PUBLISHER_ENABLED=true
SCHOOL_PROVISIONING_RESULT_CONSUMER_ENABLED=true
SCHOOL_PROVISIONING_CONSUMER_ENABLED=true
SMS_LOG_CONSUMER_ENABLED=false

PLATFORM_SMS_API_URL_TEMPLATE=
PLATFORM_SMS_USERNAME=
PLATFORM_SMS_PASSWORD=
PLATFORM_SMS_SENDER_NAME=
PLATFORM_SMS_SUCCESS_RESPONSE_PREFIX=
PLATFORM_SMS_ENCRYPTION_KEY=

FIREBASE_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_HOST_PATH=./deploy/empty-firebase-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
REDIS_PASSWORD=replace-with-redis-password
SCHOOL_ROUTING_REDIS_CONNECTION=redis:6379,password=replace-with-redis-password
SCHOOL_ROUTING_CACHE_ENABLED=true
SCHOOL_ROUTING_CACHE_CONSUMER_ENABLED=true
SCHOOL_ROUTING_CACHE_NAMESPACE=mdaresna-local
SCHOOL_ROUTING_CACHE_TTL_SECONDS=2592000

# Document storage: keep Local until the live R2 test and any migration have passed.
SCHOOL_DOCUMENT_STORAGE_PROVIDER=Local
SCHOOL_DOCUMENT_R2_ENDPOINT=
SCHOOL_DOCUMENT_R2_BUCKET=
SCHOOL_DOCUMENT_R2_ACCESS_KEY_ID=
SCHOOL_DOCUMENT_R2_SECRET_ACCESS_KEY=
SCHOOL_DOCUMENT_R2_MAX_UPLOAD_MIB=64
SCHOOL_DOCUMENT_R2_CONCURRENT_UPLOADS=2
